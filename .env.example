# --------------------------------------------------------------------------- #
# Inferno configuration — copy to `.env` and edit. EVERY value here is optional;
# the defaults yield a runnable system. Names map to nested settings groups via
# a double underscore (see backend/core/config.py). Nothing else in the codebase
# reads the environment directly.
# --------------------------------------------------------------------------- #

# -- General ---------------------------------------------------------------- #
INFERNO_ENVIRONMENT=dev                 # dev | test | prod
INFERNO_SERVICE_NAME=inferno

# -- Redis (broker + bus) --------------------------------------------------- #
INFERNO_REDIS__URL=redis://localhost:6379/0
INFERNO_REDIS__MAX_CONNECTIONS=64
INFERNO_REDIS__SOCKET_TIMEOUT_S=5.0
INFERNO_REDIS__SOCKET_CONNECT_TIMEOUT_S=5.0
INFERNO_REDIS__HEALTH_CHECK_INTERVAL_S=15

# -- Job queue + backpressure ----------------------------------------------- #
INFERNO_QUEUE__CONSUMER_GROUP=inferno-workers
INFERNO_QUEUE__BLOCK_MS=2000            # blocking read for the first job of a window
INFERNO_QUEUE__MAX_STREAM_LEN=100000    # approximate cap (XADD MAXLEN ~)
INFERNO_QUEUE__HIGH_WATERMARK=5000      # above this depth -> HTTP 429
INFERNO_QUEUE__LOW_WATERMARK=2500       # resume accepting below this (hysteresis)
INFERNO_QUEUE__RETRY_AFTER_S=2          # Retry-After header value on 429

# -- Dynamic batching (the throughput/latency lever) ------------------------ #
INFERNO_BATCHING__MAX_BATCH_SIZE=32
INFERNO_BATCHING__MAX_BATCH_WAIT_MS=20
INFERNO_BATCHING__POLL_INTERVAL_MS=1.0

# -- Reliability / timeouts ------------------------------------------------- #
INFERNO_TIMEOUTS__JOB_TIMEOUT_S=30.0
INFERNO_TIMEOUTS__RECLAIM_MIN_IDLE_MS=30000   # reclaim entries idle longer than this
INFERNO_TIMEOUTS__RECLAIM_INTERVAL_S=15.0
INFERNO_TIMEOUTS__RESULT_TTL_S=60             # late-join-safe result value TTL

# -- Gateway HTTP/WS server ------------------------------------------------- #
INFERNO_SERVER__HOST=0.0.0.0
INFERNO_SERVER__PORT=8000
INFERNO_SERVER__API_PREFIX=/api/v1
# JSON array of allowed browser origins:
INFERNO_SERVER__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -- Observability ---------------------------------------------------------- #
INFERNO_METRICS__SNAPSHOT_INTERVAL_S=1.0
INFERNO_METRICS__ROLLING_WINDOW_S=10.0
INFERNO_METRICS__ENABLE_GPU=true        # attempt pynvml GPU stats (still guarded)

# -- Worker identity + model selection -------------------------------------- #
INFERNO_WORKER__MODEL_NAME=dummy-echo   # which model THIS worker loads/serves
INFERNO_WORKER__ID_PREFIX=worker
INFERNO_WORKER__HEARTBEAT_INTERVAL_S=2.0
INFERNO_WORKER__HEARTBEAT_TTL_S=6

# -- Model registry --------------------------------------------------------- #
# Path is resolved relative to the repo by default; override to relocate.
# INFERNO_MODELS__CONFIG_PATH=backend/models/models.yaml
# INFERNO_MODELS__ARTIFACT_DIR=artifacts

# -- Inference device (GPU/CPU) + optimization ------------------------------ #
INFERNO_INFERENCE__DEVICE=auto          # auto | cpu | cuda  (auto = GPU if available, else CPU)
# INFERNO_INFERENCE__ONNX_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]
INFERNO_INFERENCE__COMPILE=false        # apply torch.compile to torch models (faster after warmup)
INFERNO_INFERENCE__QUANTIZE=none        # none | int8 (CPU) | fp16 (GPU)

# -- Result cache (skip recompute on identical inputs) ---------------------- #
INFERNO_CACHE__ENABLED=true
INFERNO_CACHE__TTL_S=300

# -- OpenTelemetry tracing (optional; off by default) ----------------------- #
INFERNO_OTEL__ENABLED=false
# INFERNO_OTEL__ENDPOINT=http://localhost:4318/v1/traces   # OTLP/HTTP collector; empty = console

# -- Streaming chat service (local LLM, SSE, RAG-grounded) ------------------- #
# Runs as its own process (scripts\run-chat.bat) on :8100; the gateway never
# loads a model. First request downloads the model (~1GB) and is slow on CPU.
INFERNO_CHAT__MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
INFERNO_CHAT__MAX_NEW_TOKENS=256
INFERNO_CHAT__TEMPERATURE=0.7
INFERNO_CHAT__PORT=8100
INFERNO_CHAT__GATEWAY_URL=http://127.0.0.1:8000   # where chat reaches the platform for RAG

# -- Durable inference history ---------------------------------------------- #
INFERNO_HISTORY__ENABLED=true
INFERNO_HISTORY__REDIS_MAXLEN=5000      # recent inferences kept in the Redis history stream
INFERNO_HISTORY__JSONL_ENABLED=true     # also append every inference to a JSONL file on disk
# INFERNO_HISTORY__JSONL_PATH=artifacts/inferences.jsonl
INFERNO_HISTORY__STORE_INPUT=true       # include a truncated input preview (never raw image/audio bytes)

# -- API-key auth (optional; OFF by default so local dev just works) --------- #
INFERNO_AUTH__ENABLED=false
INFERNO_AUTH__API_KEYS=["change-me-key-1","change-me-key-2"]   # JSON array of accepted keys
INFERNO_AUTH__HEADER_NAME=X-API-Key

# -- Per-client request quotas (optional; OFF by default) -------------------- #
INFERNO_RATELIMIT__ENABLED=false
INFERNO_RATELIMIT__REQUESTS_PER_MINUTE=120
INFERNO_RATELIMIT__WINDOW_S=60
# Behind nginx / an ingress / Render / Fly, the socket peer is the PROXY, so all
# callers share one quota bucket. Turn this on to key quotas on the left-most
# X-Forwarded-For entry instead. Leave OFF when the gateway is exposed directly:
# the header is client-supplied and trivially spoofed with nothing stripping it.
INFERNO_RATELIMIT__TRUST_PROXY_HEADERS=false

# -- Single-container / same-origin serving ---------------------------------- #
# Point this at a built frontend directory and the gateway serves the UI at /
# (same-origin, so the API and WebSockets need no cross-origin config). This is
# the mechanism behind the one-container demo image (deploy/Dockerfile.demo).
# Empty in normal dev, where Vite serves the UI on :5173.
# INFERNO_SERVER__SERVE_FRONTEND_DIR=/app/frontend-dist

# -- Streaming chat service -------------------------------------------------- #
INFERNO_CHAT__ENABLED=true              # the local-LLM SSE chat service (backend/chat/)

# -- Reliability deadlines --------------------------------------------------- #
INFERNO_TIMEOUTS__JOB_TIMEOUT_S=30      # client gives up after this
INFERNO_TIMEOUTS__RESULT_TTL_S=300      # late-join result key TTL; MUST be >= job_timeout_s
INFERNO_TIMEOUTS__RECLAIM_MIN_IDLE_MS=90000   # must exceed the slowest batch, or a healthy
                                        # worker's in-flight batch gets stolen and run twice
INFERNO_TIMEOUTS__MAX_DELIVERIES=3      # deliveries before an entry is dead-lettered
INFERNO_TIMEOUTS__INFERENCE_TIMEOUT_S=120   # watchdog: a batch past this ends the worker
                                        # process so the supervisor restarts it

# -- Logging ---------------------------------------------------------------- #
INFERNO_LOGGING__LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
INFERNO_LOGGING__RENDER_JSON=true       # false = colorized console logs for local dev
