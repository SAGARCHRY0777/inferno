{
  "name": "inferno-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Inferno — real-time ML inference operations console",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "prefetch:routes": "node scripts/prefetch-routes.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "framer-motion": "14.0.0",
    "leaflet": "^1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "3.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "playwright": "^1.49.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
