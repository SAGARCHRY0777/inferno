# Normalize line endings. Shell scripts and Dockerfiles MUST stay LF — they run
# inside Linux containers, where CRLF breaks the interpreter ("bad interpreter").
* text=auto

*.sh text eol=lf
Dockerfile* text eol=lf
*.bat text eol=crlf

# Binary assets (never normalize / diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webm binary
*.ico binary
*.pt binary
*.onnx binary
*.whl binary
*.tar.gz binary
